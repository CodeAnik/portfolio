---
import Icon from '@/components/ui/Icon.astro';
import { categoryLabel, type Project } from '@/data/projects';

interface Props {
  project: Project;
  size?: 'card' | 'hero';
  class?: string;
}

// Typographic cover for projects without a public screenshot (private client code or unreleased apps).
// It presents the stack as a designed graphic and never imitates a screenshot.
const { project, size = 'card', class: className } = Astro.props;
const stack = project.stack.slice(0, size === 'hero' ? 8 : 5);
---

<div class:list={['code-cover absolute inset-0 flex flex-col justify-between overflow-hidden text-white', size === 'hero' ? 'p-6 sm:p-10 lg:p-12' : 'p-5 sm:p-6', className]} aria-hidden="true">
  <div class="code-cover__grid absolute inset-0"></div>
  <div class="relative flex items-center justify-between gap-3 font-mono text-[0.6875rem] tracking-wide text-white/60">
    <span class="flex items-center gap-1.5">
      <span class="size-2 rounded-full bg-[#ff5f57]"></span>
      <span class="size-2 rounded-full bg-[#febc2e]"></span>
      <span class="size-2 rounded-full bg-[#28c840]"></span>
      <span class="ml-2 hidden sm:inline">~/{project.slug}</span>
    </span>
    <span>{categoryLabel(project.categories[0]!)}</span>
  </div>
  <p class:list={['relative font-display font-extrabold tracking-[-0.03em] text-balance', size === 'hero' ? 'text-2xl sm:text-4xl lg:text-5xl' : 'text-2xl sm:text-[1.65rem]']}>
    {project.title}
  </p>
  <div class="relative">
    <ul class="flex flex-wrap gap-1.5">
      {stack.map((tech) => <li class="rounded-md border border-white/15 bg-white/[0.07] px-2 py-0.5 font-mono text-[0.6875rem] text-white/85">{tech}</li>)}
    </ul>
    <p class="mt-3 flex items-center gap-1.5 font-mono text-[0.6875rem] text-white/55">
      <Icon name={project.code === 'private' ? 'shield-check' : 'github'} size={13} />
      {project.code === 'private' ? 'Private client codebase' : 'Public repository'}
    </p>
  </div>
</div>

<style>
  .code-cover {
    background:
      radial-gradient(circle at 12% 0%, rgb(244 16 103 / 0.45), transparent 55%),
      radial-gradient(circle at 100% 100%, rgb(255 193 7 / 0.28), transparent 55%),
      radial-gradient(circle at 70% 30%, rgb(233 95 50 / 0.18), transparent 50%),
      #101015;
  }
  .code-cover__grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at 50% 40%, #000 35%, transparent 85%);
  }
</style>
