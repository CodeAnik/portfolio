---
import ProjectCard from '@/components/cards/ProjectCard.astro';
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { featuredProjects, projects } from '@/data/projects';
import { url } from '@/lib/url';

const items = featuredProjects.slice(0, 6);
---

<section id="work" class="section border-y border-border bg-bg-subtle" aria-labelledby="work-title">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
      <SectionHeading
        id="work-title"
        eyebrow="06 — Selected work"
        title="Platforms, stores and production websites"
        lead="Full-stack client platforms, WooCommerce stores and live business websites — what each one does, the stack, and a link to the live site."
      />
      <div data-reveal>
        <Button href={url('/projects/')} variant="secondary" icon="arrow-right">All {projects.length} projects</Button>
      </div>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-[auto_auto_auto]">
      {
        items.map((project, index) => (
          <ProjectCard
            project={project}
            size={index === 0 ? 'large' : 'default'}
            revealDelay={(index % 3) * 70}
            class={index === 0 ? 'md:col-span-2 lg:row-span-2' : index === items.length - 1 ? 'md:max-lg:col-span-2' : ''}
          />
        ))
      }
    </div>
  </div>
</section>
