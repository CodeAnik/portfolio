---
import ContactForm from '@/components/forms/ContactForm.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import type { IconName } from '@/components/ui/icons';
import { profile } from '@/data/profile';

interface Props {
  /** Show the section heading (hidden on the contact page, which has its own page header). */
  heading?: boolean;
}

const { heading = true } = Astro.props;

const channels: { icon: IconName; label: string; value: string; href?: string; external?: boolean }[] = [
  { icon: 'mail', label: 'Email', value: profile.email, href: `mailto:${profile.email}` },
  { icon: 'whatsapp', label: 'WhatsApp', value: profile.phone.display, href: profile.whatsapp.href, external: true },
  { icon: 'phone', label: 'Phone', value: profile.phone.display, href: profile.phone.href },
  { icon: 'map-pin', label: 'Location', value: profile.location.label },
];
---

<section id="contact" class:list={['section', heading && 'border-t border-border bg-bg-subtle']} aria-labelledby={heading ? 'contact-title' : undefined} aria-label={heading ? undefined : 'Contact form and details'}>
  <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-14">
    <div class="min-w-0 lg:col-span-5">
      {
        heading && (
          <SectionHeading
            id="contact-title"
            eyebrow="08 — Contact"
            title="Let’s work together"
            lead="Need a complete website, web application, e-commerce store or custom development? Send a message, or reach me on WhatsApp."
          />
        )
      }
      <ul class:list={['space-y-3', heading && 'mt-10']} data-reveal>
        {
          channels.map((channel) => {
            const body = (
              <>
                <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand-ink">
                  <Icon name={channel.icon} size={20} />
                </span>
                <span class="min-w-0">
                  <span class="block text-xs font-medium tracking-wide text-fg-subtle uppercase">{channel.label}</span>
                  <span class="block truncate font-semibold text-fg">{channel.value}</span>
                </span>
              </>
            );
            return (
              <li>
                {channel.href ? (
                  <a
                    href={channel.href}
                    target={channel.external ? '_blank' : undefined}
                    rel={channel.external ? 'noopener noreferrer' : undefined}
                    class="card group flex items-center gap-4 p-4 transition-colors hover:border-brand/40"
                  >
                    {body}
                    {channel.external && <span class="sr-only">(opens in a new tab)</span>}
                    <Icon name="arrow-up-right" size={18} class="ml-auto text-fg-subtle transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-brand-ink" />
                  </a>
                ) : (
                  <div class="card flex items-center gap-4 p-4">{body}</div>
                )}
              </li>
            );
          })
        }
      </ul>
      <div class="mt-8" data-reveal>
        <p class="text-sm font-semibold text-fg">Find me online</p>
        <SocialLinks class="mt-3" />
      </div>
      <p class="mt-8 flex items-center gap-2 text-sm text-fg-muted" data-reveal>
        <span class="size-2 rounded-full bg-brand" aria-hidden="true"></span>
        {profile.availability}
      </p>
    </div>

    <div class="min-w-0 lg:col-span-7" data-reveal>
      <ContactForm />
    </div>
  </div>
</section>
