---
import Icon from '@/components/ui/Icon.astro';
import { education } from '@/data/education';
---

<ol class="space-y-4">
  {
    education.map((item, index) => (
      <li class="card group flex gap-5 p-5 transition-colors hover:border-border-strong sm:p-6" data-reveal style={`--reveal-delay:${index * 70}`}>
        <span class:list={['grid size-12 shrink-0 place-items-center rounded-xl', index === 0 ? 'bg-brand-soft text-brand-ink' : 'bg-surface-2 text-fg-muted']}>
          <Icon name="graduation-cap" size={22} />
        </span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-base font-bold sm:text-lg">
              {item.shortDegree}{' '}
              <span class="font-semibold text-fg-muted">in {item.field}</span>
            </h3>
            <p class="font-mono text-xs text-fg-subtle">{item.period}</p>
          </div>
          <p class="mt-1 text-sm text-fg-muted">{item.institution}</p>
          <p class="mt-3 inline-flex rounded-md bg-surface-2 px-2 py-0.5 text-xs font-semibold text-fg">{item.result}</p>
        </div>
      </li>
    ))
  }
</ol>
