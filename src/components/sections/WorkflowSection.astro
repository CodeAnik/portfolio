---
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { profile } from '@/data/profile';

interface Props {
  eyebrow?: string;
}

const { eyebrow = '03 — How I work' } = Astro.props;
---

<section id="workflow" class="section" aria-labelledby="workflow-title">
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
      <SectionHeading
        id="workflow-title"
        eyebrow={eyebrow}
        title="AI speeds up the work. I stay in control of the code."
        lead="I use agentic coding tools to move faster on scaffolding, refactoring and documentation. Architecture, code review, testing and debugging stay with me — the same fundamentals I learned writing PHP and JavaScript by hand."
      />
      <blockquote class="card max-w-sm p-6" data-reveal>
        <Icon name="quote" size={22} class="text-brand-ink" />
        <p class="mt-3 font-display text-lg leading-snug font-semibold text-fg">If I can’t explain what a change does, it doesn’t ship.</p>
      </blockquote>
    </div>

    <ol class="relative mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      <span aria-hidden="true" class="absolute top-[2.375rem] right-[12%] left-[12%] hidden h-px bg-gradient-to-r from-brand/40 via-orange/40 to-accent/40 lg:block"></span>
      {
        profile.approach.map((step, index) => (
          <li class="card relative p-6" data-reveal style={`--reveal-delay:${index * 80}`}>
            <div class="flex items-center justify-between">
              <span class="relative grid size-12 place-items-center rounded-xl border border-border bg-bg text-brand-ink">
                <Icon name={step.icon} size={22} />
              </span>
              <span class="font-mono text-xs text-fg-subtle">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-5 text-lg font-bold">{step.title}</h3>
            <p class="mt-2 text-sm text-fg-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
