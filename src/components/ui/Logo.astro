---
import { profile } from '@/data/profile';
import { url } from '@/lib/url';

interface Props {
  class?: string;
  /** Prefix for SVG ids so the logo can appear more than once per page. */
  id?: string;
}

const { class: className, id = 'logo' } = Astro.props;
const gradientId = `${id}-ring`;
// "AK" monogram outlined from Montserrat Bold, matching public/favicon.svg.
const monogram =
  'M28.30 40.75L26.75 37L18.63 37L17.07 40.75L12.92 40.75L20.72 23.25L24.73 23.25L32.55 40.75L28.30 40.75M19.92 33.92L25.48 33.92L22.70 27.23L19.92 33.92M46.35 40.75L40.75 33.88L38.40 36.33L38.40 40.75L34.38 40.75L34.38 23.25L38.40 23.25L38.40 31.42L46.15 23.25L50.65 23.25L43.40 31.05L51.08 40.75';
---

<a href={url('/')} class:list={['group inline-flex items-center gap-3 rounded-lg', className]} aria-label={`${profile.name} — home`}>
  <svg viewBox="0 0 64 64" width="36" height="36" aria-hidden="true" class="shrink-0 transition-transform duration-500 ease-out group-hover:rotate-[-8deg]">
    <defs>
      <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffc107"></stop>
        <stop offset=".5" stop-color="#e95f32"></stop>
        <stop offset="1" stop-color="#f41067"></stop>
      </linearGradient>
    </defs>
    <circle cx="32" cy="32" r="30" fill="#0e0e11"></circle>
    <circle cx="32" cy="32" r="28" fill="none" stroke={`url(#${gradientId})`} stroke-width="4"></circle>
    <path fill="#fff" d={monogram}></path>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-[0.95rem] font-bold tracking-tight text-fg">{profile.shortName}</span>
    <span class="mt-1 font-mono text-[0.625rem] tracking-[0.14em] text-fg-subtle uppercase">Full-Stack Developer</span>
  </span>
</a>
