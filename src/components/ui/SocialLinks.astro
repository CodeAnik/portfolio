---
import { socialLinks } from '@/data/social';
import Icon from './Icon.astro';

interface Props {
  class?: string;
  size?: 'sm' | 'md';
}

const { class: className, size = 'md' } = Astro.props;
const box = size === 'sm' ? 'size-9' : 'size-11';
---

<ul class:list={['flex flex-wrap items-center gap-2', className]} aria-label="Social profiles">
  {
    socialLinks.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="me noopener noreferrer"
          class:list={[
            'grid place-items-center rounded-full border border-border bg-surface text-fg-muted transition-all duration-200 hover:-translate-y-0.5 hover:border-brand/50 hover:text-brand-ink hover:shadow-[0_8px_20px_-10px_rgb(244_16_103/0.6)]',
            box,
          ]}
          title={link.name}
        >
          <Icon name={link.icon} size={size === 'sm' ? 16 : 18} />
          <span class="sr-only">{`${link.name} (opens in a new tab)`}</span>
        </a>
      </li>
    ))
  }
</ul>
