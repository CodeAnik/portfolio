---
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import CodeCover from '@/components/cards/CodeCover.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import CTASection from '@/components/sections/CTASection.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { profile } from '@/data/profile';
import { categoryLabel, projects, type Project } from '@/data/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { absoluteUrl, url } from '@/lib/url';

export const getStaticPaths = (() =>
  projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      next: projects[(index + 1) % projects.length]!,
      related: projects
        .filter((p) => p.slug !== project.slug && p.categories.some((c) => project.categories.includes(c)))
        .slice(0, 3),
    },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
  related: Project[];
}

const { project, next, related } = Astro.props;
const breadcrumbs = [
  { name: 'Projects', path: '/projects/' },
  { name: project.title, path: `/projects/${project.slug}/` },
];

const shareImage = project.cover
  ? await getImage({ src: project.cover.src, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' })
  : undefined;
const meta = [
  { label: 'Type', value: project.kind },
  { label: 'Industry', value: project.industry },
  project.client && { label: 'Client', value: project.client },
  project.year && { label: 'Year', value: project.year },
  { label: 'Category', value: project.categories.map(categoryLabel).join(', ') },
  project.code && { label: 'Source code', value: project.code === 'private' ? 'Private (client)' : 'Public' },
].filter(Boolean) as { label: string; value: string }[];

const creativeWork = {
  '@type': 'CreativeWork',
  '@id': `${absoluteUrl(`/projects/${project.slug}/`, Astro.site)}#work`,
  name: project.title,
  description: project.summary,
  ...(shareImage ? { image: new URL(shareImage.src, Astro.site).href } : {}),
  creator: { '@id': `${absoluteUrl('/', Astro.site)}#person` },
  keywords: project.stack.join(', '),
  ...(project.year ? { dateCreated: project.year } : {}),
  ...(project.liveUrl ? { url: project.liveUrl } : {}),
};
---

<BaseLayout
  title={`${project.title} — ${project.kind}`}
  description={`${project.summary} ${project.kind} by ${profile.name}.`}
  image={shareImage?.src}
  imageAlt={project.cover?.alt}
  breadcrumbs={breadcrumbs}
  schema={[creativeWork]}
>
  <PageHeader eyebrow={categoryLabel(project.categories[0]!)} title={project.title} lead={project.summary} breadcrumbs={breadcrumbs}>
    <div class="animate-rise mt-8 flex flex-wrap gap-3" style="--i:4">
      {
        project.liveUrl && (
          <Button href={project.liveUrl} external icon="arrow-up-right">
            Visit live site
          </Button>
        )
      }
      {
        project.repoUrl && (
          <Button href={project.repoUrl} external variant="secondary" icon="github" iconPosition="start">
            Source code
          </Button>
        )
      }
      <Button href={url('/projects/')} variant={project.liveUrl ? 'secondary' : 'primary'} icon="arrow-left" iconPosition="start">
        All projects
      </Button>
    </div>
  </PageHeader>

  <section class="section pt-12 sm:pt-16" aria-label="Project details">
    <div class="container-x">
      {
        project.cover?.framed ? (
          <figure class="card overflow-hidden shadow-[var(--shadow-lg)]" data-reveal>
            <Image src={project.cover.src} alt={project.cover.alt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1216px) 1152px, 94vw" loading="eager" class="h-auto w-full" />
          </figure>
        ) : project.cover ? (
          <figure class="browser-frame card overflow-hidden shadow-[var(--shadow-lg)]" data-reveal>
            <div class="flex items-center gap-2 border-b border-border bg-surface-2 px-4 py-3" aria-hidden="true">
              <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
              <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
              <span class="size-2.5 rounded-full bg-[#28c840]"></span>
              {
                project.liveUrl && (
                  <span class="ml-3 truncate rounded-md bg-bg px-3 py-1 font-mono text-xs text-fg-subtle">{new URL(project.liveUrl).host}</span>
                )
              }
            </div>
            <Image
              src={project.cover.src}
              alt={project.cover.alt}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 1216px) 1152px, 94vw"
              loading="eager"
              class="h-auto w-full"
            />
          </figure>
        ) : (
          <div class="card relative aspect-[4/3] overflow-hidden shadow-[var(--shadow-lg)] sm:aspect-[2/1] lg:aspect-[21/9]" data-reveal>
            <CodeCover project={project} size="hero" />
          </div>
        )
      }

      <div class="mt-16 grid gap-12 lg:grid-cols-12 lg:gap-16">
        <aside class="min-w-0 lg:col-span-4" aria-label="Project facts">
          <dl class="card divide-y divide-border lg:sticky lg:top-28" data-reveal>
            {
              meta.map((item) => (
                <div class="flex items-start justify-between gap-4 px-5 py-4">
                  <dt class="text-sm text-fg-subtle">{item.label}</dt>
                  <dd class="text-right text-sm font-semibold text-fg">{item.value}</dd>
                </div>
              ))
            }
            <div class="px-5 py-4">
              <dt class="text-sm text-fg-subtle">Technologies</dt>
              <dd class="mt-3">
                <ul class="flex flex-wrap gap-1.5">
                  {project.stack.map((tech) => <li class="rounded-md bg-surface-2 px-2 py-0.5 text-xs font-medium text-fg-muted">{tech}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
        </aside>

        <div class="min-w-0 lg:col-span-8">
          <h2 class="text-2xl font-bold sm:text-3xl" data-reveal>Overview</h2>
          <div class="mt-6 space-y-5 text-base text-fg-muted sm:text-lg" data-reveal>
            {project.description.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          {
            project.contribution && (
              <>
                <h2 class="mt-14 text-2xl font-bold sm:text-3xl" data-reveal>
                  My contribution
                </h2>
                <ul class="mt-6 space-y-3" data-reveal>
                  {project.contribution.map((item) => (
                    <li class="flex gap-3 text-base text-fg-muted">
                      <Icon name="check" size={18} class="mt-1 text-brand-ink" strokeWidth={2.25} />
                      <span class="min-w-0 [overflow-wrap:anywhere]">{item}</span>
                    </li>
                  ))}
                </ul>
              </>
            )
          }

          {
            project.features && (
              <>
                <h2 class="mt-14 text-2xl font-bold sm:text-3xl" data-reveal>
                  Key functionality
                </h2>
                <ul class="mt-6 grid gap-3 sm:grid-cols-2" data-reveal>
                  {project.features.map((feature) => (
                    <li class="card flex items-center gap-3 p-4 text-sm font-medium text-fg">
                      <Icon name="sparkles" size={18} class="text-brand-ink" />
                      {feature}
                    </li>
                  ))}
                </ul>
              </>
            )
          }

          {
            project.links && (
              <>
                <h2 class="mt-14 text-2xl font-bold sm:text-3xl" data-reveal>
                  Source code
                </h2>
                <ul class="mt-6 flex flex-wrap gap-2" data-reveal>
                  {project.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-fg-muted transition-colors hover:border-brand/40 hover:text-brand-ink"
                      >
                        <Icon name="github" size={15} />
                        {link.label}
                        <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }

          {
            project.code === 'private' && (
              <p class="mt-10 flex gap-3 rounded-[var(--radius-control)] border border-border bg-surface-2 p-4 text-sm text-fg-muted" data-reveal>
                <Icon name="shield-check" size={18} class="mt-0.5 text-brand-ink" />
                The source code belongs to the client and isn’t public. I’m happy to walk through the architecture and my part of it in an interview.
              </p>
            )
          }

          {
            project.gallery.length > 0 && (
              <>
                <h2 class="mt-16 text-2xl font-bold sm:text-3xl" data-reveal>
                  Screens
                </h2>
                <div class="mt-8 space-y-10">
                  {project.gallery.map((shot, index) => (
                    <figure data-reveal>
                      {shot.fullPage ? (
                        <div
                          class="card max-h-[80vh] overflow-y-auto overscroll-contain"
                          tabindex="0"
                          role="region"
                          aria-label={`${shot.caption ?? 'Screenshot'} — scrollable full-page capture`}
                        >
                          <Image src={shot.src} alt={shot.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 760px, 94vw" class="h-auto w-full" />
                        </div>
                      ) : (
                        <div class="card overflow-hidden">
                          <Image src={shot.src} alt={shot.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 760px, 94vw" class="h-auto w-full" />
                        </div>
                      )}
                      {shot.caption && (
                        <figcaption class="mt-3 flex items-center gap-2 text-sm text-fg-subtle">
                          <span class="font-mono text-xs text-brand-ink">{String(index + 1).padStart(2, '0')}</span>
                          {shot.caption}
                          {shot.fullPage && <span class="text-fg-subtle">· scroll to see the whole page</span>}
                        </figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              </>
            )
          }

          <a
            href={url(`/projects/${next.slug}/`)}
            class="card group mt-16 flex items-center justify-between gap-6 p-6 transition-colors hover:border-brand/40"
            data-reveal
          >
            <span>
              <span class="block font-mono text-xs tracking-wide text-fg-subtle uppercase">Next project</span>
              <span class="mt-1 block font-display text-xl font-bold text-fg">{next.title}</span>
            </span>
            <Icon name="arrow-right" size={22} class="text-brand-ink transition-transform group-hover:translate-x-1" />
          </a>
        </div>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section border-t border-border bg-bg-subtle" aria-labelledby="related-title">
        <div class="container-x">
          <h2 id="related-title" class="text-2xl font-bold sm:text-3xl" data-reveal>
            Related projects
          </h2>
          <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {related.map((p, index) => (
              <ProjectCard project={p} revealDelay={index * 70} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTASection />
</BaseLayout>
